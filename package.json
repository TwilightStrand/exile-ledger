{
	"name": "exile-ledger",
	"description": "Path of Exile trade site companion: bookmarks, history, synced across machines",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"postinstall": "wxt prepare",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "wxt prepare && tsc --noEmit",
		"preview:ui": "vite --config preview/vite.config.ts"
	},
	"dependencies": {
		"preact": "11.2.0",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@preact/preset-vite": "2.10.6",
		"@tailwindcss/vite": "4.3.5",
		"happy-dom": "21.0.4",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"wxt": "0.21.5"
	},
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=24"
	}
}
